# ft-crm: plantilla de variables para PRODUCCIÓN (Dokploy). Sin secretos: el frontend no guarda
# ninguno; los tokens de sesión los firma bk-crm. Se definen en Dokploy › Environment.

# --- BFF → bk-crm (solo servidor; el navegador nunca llama directo a bk-crm) ---
# "live" es obligatorio en producción (mock está bloqueado salvo CRM_ALLOW_MOCK_IN_PRODUCTION=true).
CRM_BACKEND_MODE=live
# Red interna de Dokploy (recomendado): http://<nombre-interno-del-backend>:3000
# Alternativa por Internet: https://api.perucheck.cloud
CRM_BACKEND_URL=http://<nombre-interno-del-backend>:3000
CRM_BACKEND_TIMEOUT_MS=15000
# Cookies de sesión con atributo Secure (HTTPS). Por defecto true en producción.
CRM_COOKIE_SECURE=true
# Proxies inversos delante de Next.js: 1 con el Traefik de Dokploy (limita los intentos de login por IP).
CRM_TRUST_PROXY=1

# --- Solo modo mock (no usar en producción) ---
# CRM_ALLOW_MOCK_IN_PRODUCTION=false
# CRM_MOCK_PASSWORD=
# CRM_ENABLE_SIMULATOR=false
# CRM_MOCK_LATENCY_MS=0

# --- Build args (se fijan al construir la imagen; opcionales) ---
# NEXT_PUBLIC_INBOX_POLL_MS=6000
# NEXT_PUBLIC_CHAT_POLL_MS=4000

# --- Solo desarrollo local ---
# CRM_DEV_ORIGINS=192.168.100.8
