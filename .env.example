# ---------------------------------------------------------------------------
# CRM Inteligente EYAQ — frontend (Next.js). Copia este archivo a .env.local
# Las variables CRM_* son solo del servidor: nunca llegan al navegador.
# Los secretos (JWT, tokens de Meta, número del dueño, claves de IA) viven en bk-crm, no aquí.
# ---------------------------------------------------------------------------

# Origen de datos:
#   live = bk-crm real (requiere CRM_BACKEND_URL)
#   mock = backend simulado en memoria con datos de ejemplo (canales simulados)
CRM_BACKEND_MODE=mock

# URL de bk-crm, sin barra final. El navegador nunca la llama directo (el BFF hace de proxy).
CRM_BACKEND_URL=http://localhost:3000

# Techo de tiempo por llamada al backend (ms).
CRM_BACKEND_TIMEOUT_MS=15000

# Cookies Secure. Vacío = automático (true en producción). Producción siempre con HTTPS.
CRM_COOKIE_SECURE=

# --- Solo modo mock -----------------------------------------------------------
# Contraseña común de los usuarios de ejemplo (ver README).
CRM_MOCK_PASSWORD=demo1234
# Simulador de canales en /api/dev/simulador (mensajes entrantes, respuesta del dueño).
CRM_ENABLE_SIMULATOR=true
# Latencia artificial de cada respuesta simulada (ms).
CRM_MOCK_LATENCY_MS=120
# El modo mock se niega a arrancar en producción salvo que esto sea true (demos controladas).
CRM_ALLOW_MOCK_IN_PRODUCTION=false

# --- Navegador ----------------------------------------------------------------
# Intervalos de actualización de la Bandeja (ms). El backend aún no tiene WebSockets.
NEXT_PUBLIC_INBOX_POLL_MS=6000
NEXT_PUBLIC_CHAT_POLL_MS=4000
